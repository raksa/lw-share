{
    "name": "lw-share",
    "version": "0.0.7",
    "author": "Raksa Eng <eng.raksa@gmail.com>",
    "description": "Local Web Share: A simple static http file sharing and chat server",
    "keywords": [
        "http",
        "share",
        "static",
        "server",
        "chat"
    ],
    "main": "./src/index.mjs",
    "types": "./src/index.d.ts",
    "type": "module",
    "license": "MIT",
    "bin": {
        "lw-share": "./lw-share.mjs"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/raksa/lw-share.git"
    },
    "homepage": "https://github.com/raksa/lw-share#readme",
    "bugs": {
        "url": "https://github.com/raksa/lw-share/issues"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "preferGlobal": true,
    "files": [
        "screenshots/",
        "lw-share.mjs",
        "src/",
        "public/",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "start": "node lw-share.mjs",
        "cli": "node lw-share.mjs",
        "dev:server": "node --watch lw-share.mjs --port 3006",
        "electron": "electron scripts/electron-dev.mjs --remote-debugging-port=9226",
        "dev": "concurrently -k -s first -n server,electron -c blue,magenta \"npm run dev:server\" \"npm run electron\"",
        "test": "node --test test/fileStore.test.mjs"
    },
    "dependencies": {
        "commander": "^14.0.1",
        "express": "^5.1.0",
        "qr-image": "^3.2.0",
        "qrcode-terminal": "^0.12.0",
        "socket.io": "^4.8.1"
    },
    "devDependencies": {
        "@types/express": "^5.0.3",
        "@types/qrcode-terminal": "^0.12.2",
        "concurrently": "^10.0.6",
        "electron": "^45.2.2"
    }
}
