    "scripts": {
        "start": "node web-sharing.mjs",
        "cli": "node web-sharing.mjs",
        "test": "echo \"No tests specified\" && exit 0"
    },
    "dependencies": {
        "commander": "^14.0.1",
        "express": "^5.1.0",
        "qr-image": "^3.2.0",
