        "share",
        "static",
        "server",
        "chat"
    ],
    "main": "./src/index.mjs",
    "type": "module",
    "license": "MIT",
    "bin": {
        "web-sharing": "./web-sharing.mjs"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/raksa/web-sharing.git"
    },
    "homepage": "https://github.com/raksa/web-sharing#readme",
    "bugs": {
        "url": "https://github.com/raksa/web-sharing/issues"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "preferGlobal": true,
    "files": [
        "web-sharing.mjs",
        "src/",
        "public/",
        "README.md",
        "LICENSE"
    ],
